# Settings for `geotrustops fetch` when a pinned release is no longer on Overture's S3 and must be restored from
# the private archive of extracts. Set them as environment variables in your shell (the pipeline does not read a
# `.env` file). Access is given on request for verifying the published results; nothing else needs these.

# The private archive repository, as "<account>/<repository>".
GEOTRUSTOPS_ARCHIVE_REPO=

# A read-only token for that repository. Never commit a real value.
GEOTRUSTOPS_ARCHIVE_TOKEN=
